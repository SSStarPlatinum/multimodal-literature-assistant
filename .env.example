# ============================================================
# Docker Compose 环境变量配置
# 复制为 .env 后修改，放在项目根目录（docker-compose.yml 同级）
# ============================================================

# ===== 模型模式 =====
# api: 调用 OpenAI 兼容 API（DashScope / DeepSeek / Ollama），无需本地 GPU
# local: 本地 transformers 加载 Qwen2.5-VL（需要 GPU 或大内存）
MODEL_MODE=api

# ===== 视觉能力开关 =====
# true  = 启用视觉模型（Qwen2.5-VL / DeepSeek Flash，支持公式/图表识别）
# false = 纯文本模式，跳过图片 OCR
VISION_ENABLED=true

# ===== 公式识别 =====
# 公式检测基于标号定位（如 (1), (2.3)），默认用文本提取，稳定可靠。
# FORMULA_VL_ENABLED: 是否额外调用 VL 模型增强识别为 LaTeX。
#   默认 false（VL 识别公式容易出错，文本提取更稳定，零 API 成本）。
#   设为 true 时，对每个检测到的公式区域尝试 VL 识别，成功则用 VL 结果，失败回退文本提取。
FORMULA_VL_ENABLED=false
# 每页最多送 VL 识别的候选公式数量（仅 VL 启用时生效，控制 API 成本）
FORMULA_VL_MAX_PER_PAGE=5

# ===== 方案 A: DeepSeek 官方 API (deepseek-flash 原生支持视觉，推荐) =====
QWEN_API_BASE=https://api.deepseek.com
QWEN_API_KEY=sk-your-deepseek-api-key
QWEN_API_MODEL=deepseek-flash
QWEN_TEXT_API_MODEL=deepseek-chat

# ===== 方案 B: 阿里云 DashScope (Qwen2.5-VL, 支持视觉) =====
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_API_KEY=your-dashscope-api-key
# QWEN_API_MODEL=qwen2.5-vl-7b-instruct
# QWEN_TEXT_API_MODEL=qwen-plus

# ===== 方案 C: 本地 Ollama (deepseek-r1:1.5b, 纯文本) =====
# Docker 容器内访问宿主机 Ollama 用 host.docker.internal
# QWEN_API_BASE=http://host.docker.internal:11434/v1
# QWEN_API_KEY=ollama
# QWEN_API_MODEL=deepseek-r1:1.5b
# QWEN_TEXT_API_MODEL=deepseek-r1:1.5b
# VISION_ENABLED=false

# ===== Qwen 本地模型配置（local 模式）=====
QWEN_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct

# ===== 4-bit 量化（local 模式生效）=====
ENABLE_4BIT_QUANTIZATION=true
LOAD_IN_4BIT=true

# ===== Embedding 设备 =====
# cpu: 纯 CPU 运行（无 GPU 时）
# cuda: GPU 加速
EMBEDDING_DEVICE=cpu

# ===== Neo4j =====
NEO4J_USER=neo4j
NEO4J_PASSWORD=literature2024

# ===== Redis / Celery 异步任务队列 =====
# Redis 密码（broker 用 db0，result backend 用 db1，不暴露宿主机端口）
REDIS_PASSWORD=literature_redis_2024

# ===== 前端 API 地址 =====
VITE_API_BASE_URL=/api/v1

# ===== 国内 HuggingFace 镜像 =====
HF_ENDPOINT=https://hf-mirror.com

# ===== 本地模型路径（local 模式，取消注释并挂载）=====
# LOCAL_MODELS_PATH=./models
