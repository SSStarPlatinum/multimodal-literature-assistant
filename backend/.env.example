# ===== 多模态文献精读助手 - 后端环境配置 =====
# 复制为 .env 后修改

# ===== 应用配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# ===== 模型配置 =====
# 模型加载模式: local (本地 transformers 加载) | api (调用 OpenAI 兼容 API)
MODEL_MODE=api

# ---- 方案 A: 阿里云 DashScope (Qwen2.5-VL, 支持视觉) ----
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your-dashscope-api-key
QWEN_API_MODEL=qwen2.5-vl-7b-instruct
QWEN_TEXT_API_MODEL=qwen-plus
QWEN_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct
QWEN_MODEL_PATH=/models/Qwen2.5-VL-7B-Instruct

# ---- 方案 B: DeepSeek 官方 API (纯文本, 不支持视觉) ----
# QWEN_API_BASE=https://api.deepseek.com
# QWEN_API_KEY=your-deepseek-api-key
# QWEN_API_MODEL=deepseek-chat
# QWEN_TEXT_API_MODEL=deepseek-chat
# VISION_ENABLED=false

# ---- 方案 C: 本地 Ollama (deepseek-r1:1.5b, 纯文本) ----
# 本地开发: QWEN_API_BASE=http://localhost:11434/v1
# Docker 内: QWEN_API_BASE=http://host.docker.internal:11434/v1
# QWEN_API_BASE=http://host.docker.internal:11434/v1
# QWEN_API_KEY=ollama
# QWEN_API_MODEL=deepseek-r1:1.5b
# QWEN_TEXT_API_MODEL=deepseek-r1:1.5b
# VISION_ENABLED=false

# ===== 视觉能力开关 =====
# true:  需要 VL 模型（Qwen2.5-VL），支持图片公式 OCR / 图表识别
# false: 纯文本模型（DeepSeek/LLaMA 等），跳过图片 OCR，
#        文本型 PDF 仍可正常解析（pdfplumber 文本提取 + 正则公式识别）
VISION_ENABLED=true

# ===== 公式 VL 识别（P1-1） =====
# true:  对 PDF 中检测到的候选公式区域渲染为图片，调用 VL 模型转为 LaTeX
# false: 仅用正则检测公式（误报率较高，但零 API 成本）
FORMULA_VL_ENABLED=true
# 每页最多识别的候选公式数量（控制 API 成本，默认 5）
FORMULA_VL_MAX_PER_PAGE=5

# 生成参数
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ===== 4-bit 量化开关 =====
# 仅 local 模式生效，启用 bitsandbytes 4-bit 量化
ENABLE_4BIT_QUANTIZATION=true
LOAD_IN_4BIT=true
BNB_4BIT_COMPUTE_DTYPE=float16
BNB_4BIT_QUANT_TYPE=nf4
BNB_4BIT_USE_NESTED_QUANT=true

# ===== Embedding (BGE-M3) =====
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_PATH=/models/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ===== 向量存储 (LlamaIndex + Chroma/FAISS) =====
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=/app/data/vector_store
VECTOR_COLLECTION_NAME=literature_chunks
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ===== RAG 配置 =====
RAG_TOP_K=5
RAG_SUMMARY_TOP_K=3
RAG_FULLTEXT_TOP_K=8
RAG_ENABLE_RERANK=true
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=5

# ===== Neo4j 配置 =====
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=literature2024
NEO4J_DATABASE=neo4j

# ===== 文件存储 =====
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://frontend:80

# ===== 国内镜像源 (HuggingFace) =====
HF_ENDPOINT=https://hf-mirror.com
TRANSFORMERS_OFFLINE=0
